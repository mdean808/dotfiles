{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/bin/file-suggestion.sh"
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "deny": []
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_DIR=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; cat \"$CLAUDE_DIR/skills/unslop/SKILL.md\" | jq -Rs '{suppressOutput:true,hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:.}}'",
            "statusMessage": "Loading writing skills"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Do not use AskUserQuestion. Ask your questions as plain text in your reply, with context for each one, numbered, with your suggestion marked and explained why. Do not over-explain. Keep thinsg brief.' >&2; exit 2"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "frontend-design@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {},
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled"
}
