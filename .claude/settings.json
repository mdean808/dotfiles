{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/bin/file-suggestion.sh"
  },
  "permissions": {
    "deny": [],
    "additionalDirectories": [
      "~/.scratch"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "frontend-design@anthropic-plugin-directory": true,
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled",
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"node\" \"/home/morgan/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"node\" \"/home/morgan/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"node\" \"/home/morgan/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"node\" \"/home/morgan/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"node\" \"/home/morgan/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"node\" \"/home/morgan/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"node\" \"/home/morgan/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"node\" \"/home/morgan/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"node\" \"/home/morgan/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
