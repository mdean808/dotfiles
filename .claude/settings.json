{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/bin/file-suggestion.sh"
  },
  "permissions": {
    "deny": [],
    "additionalDirectories": [
      "~/.scratch"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "impeccable@impeccable": true,
    "hill-climb@hill-climb": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "hill-climb": {
      "source": {
        "source": "github",
        "repo": "Bil0000/Hill-Climb"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled",
  "agentPushNotifEnabled": true
}
