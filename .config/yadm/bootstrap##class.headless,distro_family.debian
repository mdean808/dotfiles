#!/bin/sh

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$dir/bootstrap.common"
. "$dir/bootstrap.debian"

step_packages() {
  apt_install \
    zsh git curl wget ca-certificates openssh-client build-essential python3 \
    tmux lazygit zoxide ripgrep fd-find htop unzip jq locales
}

step_sparse() {
  yadm sparse-checkout set --no-cone '/*' \
    '!/.config/autostart/' \
    '!/.config/ghostty/' \
    '!/.config/keyd/' \
    '!/.config/mimeapps.list' \
    '!/.config/smug/' \
    '!/.config/vicinae/' \
    '!/.config/yadm/bootstrap##*arch' \
    '!/.config/yadm/keybindings.sh' \
    '!/.config/yadm/keyd-sync.sh' \
    '!/.config/yadm/workspaces.sh' \
    '!/.local/bin/remote-dev' \
    '!/.local/bin/startup-workspaces' \
    '!/.local/share/applications/'
}

step_locale() {
  if locale -a | grep -qix 'en_US.utf8'; then already 'en_US.UTF-8 is generated'; fi
  sudo locale-gen en_US.UTF-8
}

run sparse 'drop desktop-only files from the yadm checkout'
run packages 'install apt packages'
run locale 'generate the en_US.UTF-8 locale'
run neovim 'install Neovim into /opt'
run gh 'install the GitHub CLI'
run glab 'install the GitLab CLI'
run docker 'install Docker from the Docker apt repo'
run fd 'link fdfind as fd'
common_steps
