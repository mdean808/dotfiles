#!/bin/sh

have() { command -v "$1" >/dev/null 2>&1; }

run() {
  printf '\n==> %s\n' "$1"
  "step_$1"
}

step_omz() {
  if [ -d "$HOME/.oh-my-zsh" ]; then return 0; fi
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" \
    "" --unattended --keep-zshrc
}

step_zsh_defer() {
  if [ -d "$HOME/.zsh/zsh-defer" ]; then return 0; fi
  git clone --depth 1 https://github.com/romkatv/zsh-defer.git "$HOME/.zsh/zsh-defer"
}

step_nvim_config() {
  if [ ! -d "$HOME/.config/nvim" ]; then
    git clone https://github.com/mdean808/nvim-config "$HOME/.config/nvim"
  fi
  if [ "$(git -C "$HOME/.config/nvim" remote get-url origin 2>/dev/null)" = https://github.com/mdean808/nvim-config ]; then
    git -C "$HOME/.config/nvim" remote set-url origin git@github.com:mdean808/nvim-config.git
  fi
}

step_scratch() {
  "$HOME/.config/yadm/scratch.sh" pull || scratch_failed=1
}

step_nvm() {
  if [ -d "$HOME/.nvm" ]; then return 0; fi
  PROFILE=/dev/null bash -c 'curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash'
}

step_node() {
  if [ -n "$(ls -A "$HOME/.nvm/versions/node" 2>/dev/null)" ]; then return 0; fi
  bash -c '. "$HOME/.nvm/nvm.sh" --no-use && nvm install node'
}

step_uv() {
  if have uv || [ -x "$HOME/.local/bin/uv" ]; then return 0; fi
  curl -LsSf https://astral.sh/uv/install.sh | UV_NO_MODIFY_PATH=1 sh
}

step_bun() {
  if have bun; then return 0; fi
  curl -fsSL https://bun.sh/install | bash
}

step_go() {
  if [ -x /usr/local/go/bin/go ]; then return 0; fi
  case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) echo "no go build for $(uname -m)" >&2; return 1 ;;
  esac
  ver=$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -n 1)
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/go.tar.gz" "https://go.dev/dl/$ver.linux-$arch.tar.gz"
  sudo rm -rf /usr/local/go
  sudo tar -C /usr/local -xzf "$tmp/go.tar.gz"
  rm -rf "$tmp"
}

step_pnpm() {
  if [ -x "$HOME/.local/share/pnpm/bin/pnpm" ]; then return 0; fi
  tmp=$(mktemp -d)
  curl -fsSL https://get.pnpm.io/install.sh | SHELL="$(command -v zsh)" ZDOTDIR="$tmp" sh -
  rm -rf "$tmp"
}

step_claude() {
  if have claude; then return 0; fi
  curl -fsSL https://claude.ai/install.sh | bash
}

step_vicinae() {
  if ! have vicinae; then
    curl -fsSL https://vicinae.com/install.sh | sudo bash
    sudo chmod -R a+rX /usr/local/lib/vicinae
  fi
  systemctl --user enable --now vicinae
}

step_keyd() {
  sudo install -D -m 644 "$HOME/.config/keyd/default.conf" /etc/keyd/default.conf
  sudo systemctl enable keyd
  sudo systemctl restart keyd
}

step_keybindings() { "$HOME/.config/yadm/keybindings.sh"; }

step_docker_service() {
  sudo systemctl enable --now docker
  if id -nG "$(id -un)" | tr ' ' '\n' | grep -qx docker; then return 0; fi
  sudo usermod -aG docker "$(id -un)"
}

step_login_shell() {
  _zsh=$(command -v zsh)
  _me=$(id -un)
  if [ "$(getent passwd "$_me" | cut -d: -f7)" = "$_zsh" ]; then return 0; fi
  if ! grep -qxF "$_zsh" /etc/shells; then
    echo "$_zsh" | sudo tee -a /etc/shells >/dev/null
  fi
  sudo chsh -s "$_zsh" "$_me"
}

step_font_cache() { fc-cache -f; }

common_steps() {
  run omz
  run zsh_defer
  run nvim_config
  run scratch
  run nvm
  run node
  run uv
  run bun
  run go
  run pnpm
  run claude
  run vicinae
  run keyd
  run keybindings
  run docker_service
  run login_shell
  run font_cache
  printf '\nBootstrap complete. Log out and back in for the login shell and docker group to take effect.\n'
  printf '\nStill to do by hand:\n'
  printf '  - Set api_key under [settings] in ~/.wakatime.cfg\n'
  printf '  - Set up SSH keys in ~/.ssh\n'
  if [ -n "$scratch_failed" ]; then
    printf '  - Run ~/.config/yadm/scratch.sh pull (the scratch clone failed)\n'
  fi
}
