#!/bin/sh

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

. "$HOME/.config/yadm/lib.sh"

nvim="$HOME/.config/nvim"

desktop_script() {
  if [ ! -x "$HOME/.config/yadm/$1.sh" ]; then skip "$1.sh is not on this machine"; fi
  "$HOME/.config/yadm/$1.sh"
}

step_keyd_sync() { desktop_script keyd-sync; }
step_keybindings() { desktop_script keybindings; }
step_workspaces() { desktop_script workspaces; }

step_nvim() {
  if [ ! -d "$nvim/.git" ] || [ "$(git -C "$nvim" rev-parse --show-toplevel)" != "$nvim" ]; then
    skip '~/.config/nvim is not a git repo'
  fi
  _before=$(git -C "$nvim" rev-parse HEAD)
  git -C "$nvim" pull --quiet --rebase --autostash
  if [ "$(git -C "$nvim" rev-parse HEAD)" = "$_before" ]; then already 'up to date'; fi
  note "$(git -C "$nvim" rev-list --count "$_before..HEAD") new commits"
}

step_scratch() { "$HOME/.config/yadm/scratch.sh" pull; }

title 'yadm post-pull'
desktop_only keyd_sync 'copy the keyd config to /etc/keyd if it changed'
desktop_only keybindings 'apply GNOME keybindings'
desktop_only workspaces 'pin apps to GNOME workspaces'
run nvim 'pull the Neovim config'
work_only scratch 'pull the scratch notes'
printf '\n'
