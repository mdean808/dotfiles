#!/bin/sh

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

. "$HOME/.config/yadm/lib.sh"

nvim="$HOME/.config/nvim"

step_nvim() {
  if [ ! -d "$nvim" ]; then skip '~/.config/nvim does not exist'; fi
  case "$(git -C "$nvim" remote get-url origin 2>/dev/null)" in
    git@github.com:mdean808/nvim-config.git | https://github.com/mdean808/nvim-config) ;;
    *) skip '~/.config/nvim is not mdean808/nvim-config' ;;
  esac
  if [ "$(git -C "$nvim" rev-parse --show-toplevel)" != "$nvim" ]; then
    skip '~/.config/nvim is not a git repo'
  fi

  git -C "$nvim" add -A
  if ! git -C "$nvim" diff --cached --quiet; then
    printf 'Committing:\n'
    git -C "$nvim" status --short
    git -C "$nvim" commit --quiet -m "${NVIM_SYNC_MESSAGE:-Sync nvim config}"
  fi

  if ! git -C "$nvim" rev-parse --verify --quiet '@{u}' >/dev/null; then
    skip 'the current branch has no upstream'
  fi
  _ahead=$(git -C "$nvim" rev-list --count '@{u}..HEAD')
  if [ "$_ahead" -eq 0 ]; then already 'nothing to push'; fi
  git -C "$nvim" push --quiet
  note "pushed $_ahead commits"
}

step_scratch() { "$HOME/.config/yadm/scratch.sh" push; }

title 'yadm post-push'
run nvim 'commit and push the Neovim config'
work_only scratch 'push the scratch notes'
printf '\n'
