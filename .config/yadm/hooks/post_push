#!/bin/sh

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

sync_nvim() {
  repo="$HOME/.config/nvim"

  [ -d "$repo" ] || return 0
  case "$(git -C "$repo" remote get-url origin 2>/dev/null)" in
    git@github.com:mdean808/nvim-config.git | https://github.com/mdean808/nvim-config) ;;
    *)
      printf '\nwarning: ~/.config/nvim is not mdean808/nvim-config, skipping nvim sync\n' >&2
      return 0 ;;
  esac
  [ "$(git -C "$repo" rev-parse --show-toplevel)" = "$repo" ] || return 0

  git -C "$repo" add -A

  if ! git -C "$repo" diff --cached --quiet; then
    git -C "$repo" commit -m "${NVIM_SYNC_MESSAGE:-Sync nvim config}" || return 0
  fi

  if [ -z "$(git -C "$repo" log '@{u}..HEAD' --oneline 2>/dev/null)" ]; then
    return 0
  fi

  printf '\n==> pushing nvim config\n'
  git -C "$repo" push
}

sync_nvim
yadm config --get-all local.class | grep -qx headless || "$HOME/.config/yadm/scratch.sh" push
