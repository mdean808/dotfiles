#!/bin/sh

. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/bootstrap.common"

step_packages() {
  _lock=/var/lib/pacman/db.lck
  if [ -e "$_lock" ] && pgrep -x pacman >/dev/null; then
    echo 'waiting for another pacman to finish'
    while [ -e "$_lock" ] && pgrep -x pacman >/dev/null; do sleep 2; done
  fi
  if [ -e "$_lock" ]; then
    fail "no pacman is running but $_lock exists. Remove it with sudo rm $_lock"
  fi
  sudo pacman -Syu --needed --noconfirm \
    zsh git curl wget unzip openssh base-devel python \
    neovim tmux lazygit github-cli glab zoxide ripgrep fd htop jq \
    docker docker-buildx docker-compose go uv bun pnpm \
    keyd ghostty fontconfig ttf-firacode-nerd \
    noto-fonts noto-fonts-emoji noto-fonts-cjk
  if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
    stop 'the kernel was upgraded. Reboot, then run yadm bootstrap again'
  fi
}

step_sparse() {
  yadm sparse-checkout set --no-cone '/*' \
    '!/.config/autostart/' \
    '!/.config/vicinae/' \
    '!/.config/yadm/bootstrap##*debian' \
    '!/.config/yadm/bootstrap.debian' \
    '!/.config/yadm/keybindings.sh' \
    '!/.config/yadm/workspaces.sh' \
    '!/.local/bin/startup-workspaces' \
    '!/.local/share/applications/local.ghostty.startup.desktop' \
    '!/.local/share/gnome-shell/extensions/split-new-window@mdean808/'
}

aur_packages='zen-browser-bin slack-desktop'

step_yay() {
  if have yay; then already "$(yay --version | cut -d' ' -f1-2) is installed"; fi
  tmp=$(mktemp -d)
  git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
  (cd "$tmp/yay-bin" && makepkg -si --noconfirm)
  rm -rf "$tmp"
}

step_aur() {
  if pacman -Q $aur_packages >/dev/null 2>&1; then already 'all AUR packages are installed'; fi
  yay -S --needed --noconfirm $aur_packages
}

step_go() {
  if have go; then already "$(go env GOVERSION) is installed by pacman"; fi
  fail 'go is missing. It comes from the packages step'
}

step_smug() {
  if [ -x "$HOME/go/bin/smug" ]; then already 'smug is installed'; fi
  go install github.com/ivaaaan/smug@latest
}

step_pnpm() {
  if have pnpm; then already 'pnpm is installed by pacman'; fi
  fail 'pnpm is missing. It comes from the packages step'
}

manual_steps() {
  if is_class personal || is_class work; then return 0; fi
  todo 'Set the machine class for git identity: yadm config --add local.class personal && yadm alt'
}

run sparse 'drop Debian-only and GNOME-only files from the yadm checkout'
run packages 'upgrade the system and install pacman packages'
run yay 'install yay from the AUR' packages
run aur 'install Zen and Slack from the AUR' yay
common_steps
