#!/bin/sh
set -e

. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/bootstrap.common"

step_packages() {
  sudo apt-get update
  sudo apt-get install -y \
    zsh git curl wget ca-certificates openssh-client build-essential \
    lazygit zoxide ripgrep fd-find htop fontconfig unzip keyd ghostty \
    fonts-noto-core fonts-noto-color-emoji fonts-noto-cjk
}

step_neovim() {
  if have nvim; then return 0; fi
  case "$(uname -m)" in
    x86_64) asset=nvim-linux-x86_64 ;;
    aarch64 | arm64) asset=nvim-linux-arm64 ;;
    *) echo "no neovim build for $(uname -m)" >&2; return 1 ;;
  esac
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/nvim.tar.gz" \
    "https://github.com/neovim/neovim/releases/download/stable/$asset.tar.gz"
  sudo tar -C /opt -xzf "$tmp/nvim.tar.gz"
  sudo ln -sfn "/opt/$asset/bin/nvim" /usr/local/bin/nvim
  rm -rf "$tmp"
}

step_nerd_font() {
  if fc-list | grep -qi 'FiraCode Nerd Font'; then return 0; fi
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/FiraCode.zip" \
    https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip
  mkdir -p "$HOME/.local/share/fonts/FiraCode"
  unzip -o -q "$tmp/FiraCode.zip" -d "$HOME/.local/share/fonts/FiraCode"
  rm -rf "$tmp"
}

step_fd() {
  if have fd; then return 0; fi
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$(command -v fdfind)" "$HOME/.local/bin/fd"
}

run packages
run neovim
run nerd_font
run fd
common_steps
