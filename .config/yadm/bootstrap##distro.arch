#!/bin/sh
set -e

. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/bootstrap.common"

step_packages() {
  sudo pacman -S --needed --noconfirm \
    zsh git curl openssh base-devel \
    neovim lazygit github-cli glab ghostty zoxide ripgrep fd htop keyd \
    ttf-firacode-nerd noto-fonts noto-fonts-emoji noto-fonts-cjk
}

run packages
common_steps
