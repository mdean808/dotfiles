font-size = 10
theme = TokyoNight Moon
window-decoration = none
resize-overlay = never
keybind = ctrl+t=new_tab
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+arrow_left=resize_split:left,30
keybind = ctrl+shift+arrow_right=resize_split:right,30
keybind = ctrl+shift+arrow_up=resize_split:up,30
keybind = ctrl+shift+arrow_down=resize_split:down,30

# tab navigation 
keybind = ctrl+digit_1=goto_tab:1
keybind = ctrl+1=goto_tab:1
keybind = ctrl+digit_2=goto_tab:2
keybind = ctrl+2=goto_tab:2
keybind = ctrl+digit_3=goto_tab:3
keybind = ctrl+3=goto_tab:3
keybind = ctrl+digit_4=goto_tab:4
keybind = ctrl+4=goto_tab:4
keybind = ctrl+digit_5=goto_tab:5
keybind = ctrl+5=goto_tab:5
keybind = ctrl+digit_6=goto_tab:6
keybind = ctrl+6=goto_tab:6
keybind = ctrl+digit_7=goto_tab:7
keybind = ctrl+7=goto_tab:7
keybind = ctrl+digit_8=goto_tab:8
keybind = ctrl+8=goto_tab:8
keybind = ctrl+digit_9=last_tab
keybind = ctrl+9=last_tab
