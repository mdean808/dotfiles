#!/usr/bin/env zsh
set -euo pipefail

usage() {
  print -u2 "usage: remote-dev [-p port|local:remote]... [-f] host [smug-profile]"
  exit 2
}

fresh=0
forwards=()

while getopts p:fh opt; do
  case $opt in
    p) forwards+=(-L "${OPTARG%%:*}:localhost:${OPTARG##*:}") ;;
    f) fresh=1 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

(( $# == 1 || $# == 2 )) || usage
host=$1
profile=${2:-}

ssh_opts=(-o ExitOnForwardFailure=yes -o ServerAliveInterval=30 $forwards)

if [[ -z $profile ]]; then
  (( fresh )) && usage
  exec ssh $ssh_opts $host
fi

remote="smug start $profile -a"
(( fresh )) && remote="smug stop $profile 2>/dev/null; $remote"

exec ssh -t $ssh_opts $host "zsh -lic ${(q)remote}"
